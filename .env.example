# Copia este archivo como .env (local) o crea estas variables en Vercel.
# Vercel → Proyecto → Settings → Environment Variables

# Clave de Resend (obligatoria). Se usa en /api/send-lead para enviar el formulario.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Correo que recibe las solicitudes (opcional; por defecto dra.taverasdlama@gmail.com)
LEAD_TO_EMAIL=dra.taverasdlama@gmail.com

# Remitente (opcional). Sin dominio verificado en Resend debe quedar onboarding@resend.dev
LEAD_FROM_EMAIL=Centro Odontológico Taveras de Lama <onboarding@resend.dev>
